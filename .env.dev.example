# Development environment variables
# NOTE: This file is referenced by both the application (via dotenvy) and compose.yml
HOST=127.0.0.1

ALLOWED_ORIGIN=http://localhost:3000

AUTH0_ISSUER=https://dev-2dn3mvmvr8tccoss.us.auth0.com/
AUTH0_AUDIENCE=https://api.xlair.dev
AUTH0_DASHBOARD_CLIENT_ID=<XLAIR Dashboard の Client ID>
AUTH0_ADMIN_SUBJECTS=<Auth0 sub をカンマ区切りで指定>

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=xlair
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpassword

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=xlair
R2_ACCESS_KEY_ID=<R2 access key ID>
R2_SECRET_ACCESS_KEY=<R2 secret access key>
R2_PUBLIC_BASE_URL=https://assets.xlair.dev
R2_UPLOAD_SECRET=<ランダムなアップロード cleanup 用シークレット>
